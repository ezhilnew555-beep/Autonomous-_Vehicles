# ─── Eareyes 2k26 Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and adjust values for your setup.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Storage (relative to backend/ directory) ─────────────────────────────────
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs

# ── YOLO Model ────────────────────────────────────────────────────────────────
# yolo11n.pt  (nano,   ~6 MB)  — fastest, least accurate
# yolo11s.pt  (small,  ~20 MB) — good balance for most hardware
# yolo11m.pt  (medium, ~50 MB) — better accuracy, needs decent GPU/CPU
# The file is auto-downloaded from Ultralytics CDN on first run.
YOLO_MODEL_PATH=models/yolo11n.pt

# Detection confidence threshold (0.0 – 1.0). Lower = more detections, more noise.
YOLO_CONFIDENCE=0.40

# Inference image size (pixels). 640 is standard. Use 320 for faster CPU inference.
YOLO_IMG_SIZE=640

# Device: "cpu"  |  "0" (first GPU)  |  "cuda"  |  "mps" (Apple Silicon)
YOLO_DEVICE=cpu

# ── ByteTrack Tracking ────────────────────────────────────────────────────────
# Minimum confidence for a detection to activate a new track
TRACK_ACTIVATION_THRESHOLD=0.25
# Frames to keep a lost track alive before pruning it
TRACK_BUFFER=30
# IoU threshold for matching detections to existing tracks
MATCH_THRESHOLD=0.8
# Number of historical center-point positions to keep per object (trajectory length)
HISTORY_LENGTH=50

# ── Motion Prediction (Phase 4) ───────────────────────────────────────────────
# Frames to predict ahead. At 30 fps: 30 = ~1 second. At 24 fps: 24 = ~1 second.
# Increase for longer horizon, but uncertainty grows proportionally.
PREDICTION_HORIZON=30
# Minimum tracked positions required before switching from linear to Kalman prediction.
# Kalman needs a few frames to converge on velocity; linear is the safe fallback.
PREDICTION_MIN_HISTORY=6

# ── Collision Risk Analysis (Phase 5) ─────────────────────────────────────────
# Time-To-Collision (TTC) thresholds in seconds
TTC_CRITICAL_THRESHOLD=1.0
TTC_HIGH_THRESHOLD=2.5
TTC_MEDIUM_THRESHOLD=4.5
# Ego vehicle travel corridor half-width in pixels
EGO_CORRIDOR_HALF_WIDTH_PX=80.0
# Critical emergency proximity threshold in pixels
CRITICAL_DISTANCE_PX=70.0


