# ─── Eareyes 2k26 Frontend — Environment Variables ────────────────────────────
# Copy to .env and adjust for your setup.
# All variables MUST be prefixed with VITE_ to be accessible in the browser.

# FastAPI backend URL.
# With the Vite proxy configured in vite.config.js, you can leave this empty
# during development and the proxy will handle /api/* calls automatically.
# Set this for production deployments:
# VITE_API_BASE_URL=http://your-server-address:8000
VITE_API_BASE_URL=
